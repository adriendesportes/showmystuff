{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@sms/*": ["__SMS_HOME__/engine/src/*"], "react": ["__SMS_HOME__/engine/node_modules/@types/react"], "react/jsx-runtime": ["__SMS_HOME__/engine/node_modules/@types/react/jsx-runtime"] }
  },
  "include": ["scenes"]
}
